@using SocOps.Models

<button
    @onclick="OnClick"
    disabled="@Square.IsFreeSpace"
    class="@GetCssClasses()"
    aria-pressed="@Square.IsMarked"
    aria-label="@(Square.IsFreeSpace ? "Free space" : Square.Text)">
    @if (Square.IsFreeSpace)
    {
        <span style="font-size: 1.25rem;" aria-hidden="true">&#9733;</span>
    }
    else
    {
        <span>@Square.Text</span>
        @if (Square.IsMarked)
        {
            <span style="position: absolute; top: 3px; right: 4px; font-size: 0.55rem; font-weight: 900;">&#10003;</span>
        }
    }
</button>

@code {
    [Parameter]
    public BingoSquareData Square { get; set; } = null!;

    [Parameter]
    public bool IsWinning { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    private string GetCssClasses()
    {
        if (Square.IsFreeSpace) return "sq-base sq-free";
        if (IsWinning)          return "sq-base sq-winning";
        if (Square.IsMarked)    return "sq-base sq-marked";
        return "sq-base sq-normal";
    }
}
