<div class="paper-bg min-h-full flex flex-col items-center justify-center p-6">
    <div class="card-paper shadow-cut-lg max-w-sm w-full p-8 relative">
        <div class="stamp-tag absolute" style="top: -12px; right: 20px;">Social Bingo</div>

        <h1 class="font-display font-black text-ink tracking-tight"
            style="font-size: 3.5rem; line-height: 1; margin-bottom: 0.25rem;">Soc Ops</h1>
        <p class="uppercase tracking-widest text-ink-muted"
           style="font-size: 0.7rem; margin-bottom: 2rem;">Find your people. Get five in a row.</p>

        <div class="card-inset p-4" style="margin-bottom: 2rem;">
            <p class="uppercase tracking-widest text-ink-muted"
               style="font-size: 0.65rem; font-weight: 600; margin-bottom: 0.75rem;">Select Mode</p>
            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                <ModeButton
                    Mode="Bingo"
                    Icon="🎲"
                    Label="BINGO"
                    Description="5x5 grid • Get 5 in a row"
                    ButtonClass="btn-primary"
                    OnSelected="@OnModeSelected" />
                
                <ModeButton
                    Mode="ScavengerHunt"
                    Icon="🔍"
                    Label="TREASURE HUNT"
                    Description="Checklist • Find them all"
                    ButtonClass="btn-secondary"
                    OnSelected="@OnModeSelected" />
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback<string> OnModeSelected { get; set; }
}
